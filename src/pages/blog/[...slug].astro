---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import CTAFinal from '../../components/sections/CTAFinal.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteUrl = Astro.site?.origin ?? 'https://www.woof-parcs.fr';

const author = {
  name: 'Antoine Allaux',
  role: 'Fondateur de Woof!',
  bio: "Fondateur de Woof! et dirigeant du groupe Herkules Fitness, spécialiste des équipements sportifs d'extérieur pour collectivités. Il accompagne mairies, bailleurs et aménageurs dans la création de parcs canins et d'aires d'agility durables et sécurisés.",
  url: `${siteUrl}/qui-sommes-nous/`,
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.image.startsWith('http') ? post.data.image : `${siteUrl}${post.data.image}`,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": author.name,
    "jobTitle": author.role,
    "description": author.bio,
    "url": author.url,
    "worksFor": { "@type": "Organization", "name": "Woof!" }
  },
  "publisher": {
    "@type": "Organization",
    "name": "Woof!",
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/assets/logo-header-woof.png` }
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog/` },
    { "@type": "ListItem", "position": 3, "name": post.data.title },
  ],
};
---

<Layout
  title={post.data.seoTitle || `${post.data.title} | Blog Woof`}
  description={post.data.seoDescription || post.data.description}
  ogImage={post.data.image}
  schema={[articleSchema, breadcrumbSchema]}
>
  <article class="py-16 bg-bg">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-muted mb-8" aria-label="Fil d'Ariane">
        <a href="/" class="hover:text-primary">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href="/blog/" class="hover:text-primary">Blog</a>
        <span aria-hidden="true">/</span>
        <span class="text-text truncate max-w-xs">{post.data.title}</span>
      </nav>

      <!-- Article header -->
      <span class="font-bold text-xs text-primary uppercase tracking-wider">{post.data.category}</span>
      <h1 class="font-display font-extrabold text-3xl sm:text-4xl text-text mt-2 mb-4 leading-tight">
        {post.data.title}
      </h1>
      <p class="text-muted text-base mb-4">{post.data.description}</p>
      <p class="text-xs text-muted mb-8">
        Par <a href="/qui-sommes-nous/" class="font-semibold text-text hover:text-primary">{author.name}</a>
        <span aria-hidden="true"> · </span>
        <time datetime={post.data.pubDate.toISOString()}>
          Publié le {post.data.pubDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </p>

      <!-- Hero image -->
      <img
        src={post.data.image}
        srcset={post.data.image.endsWith('/image.webp') ? `${post.data.image.replace('/image.webp', '/image-600.webp')} 600w, ${post.data.image} 1200w` : undefined}
        sizes="(max-width: 768px) 100vw, 768px"
        alt={post.data.imageAlt}
        class="w-full rounded-2xl mb-10 aspect-video object-cover"
        loading="eager"
        fetchpriority="high"
      />

      <!-- MDX content -->
      <div class="prose prose-lg prose-headings:font-display prose-headings:font-bold prose-a:text-primary prose-a:no-underline hover:prose-a:underline max-w-none">
        <Content />
      </div>

      <!-- Auteur -->
      <aside class="mt-12 bg-surface border border-primary/20 rounded-xl p-6">
        <p class="text-xs font-label font-bold uppercase tracking-widest text-primary mb-2">À propos de l'auteur</p>
        <p class="font-display font-bold text-text text-lg mb-1">{author.name}</p>
        <p class="text-muted font-body text-sm leading-relaxed mb-3">{author.bio}</p>
        <a href="/qui-sommes-nous/" class="text-sm font-body font-semibold text-primary hover:underline">En savoir plus sur Woof! →</a>
      </aside>

    </div>
  </article>
  <CTAFinal />
</Layout>

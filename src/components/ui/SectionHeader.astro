---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  center?: boolean;
  light?: boolean;
  as?: 'h1' | 'h2' | 'h3';
}
const { label, title, subtitle, center = false, light = false, as: Tag = 'h2' } = Astro.props;
---
<div class:list={[center && 'text-center']}>
  {label && (
    <p class:list={['font-bold text-xs tracking-widest uppercase mb-3', light ? 'text-primary-light' : 'text-primary']}>
      {label}
    </p>
  )}
  <Tag class:list={['font-display font-extrabold text-3xl md:text-4xl leading-tight mb-4', light ? 'text-white' : 'text-text']}>
    {title}
  </Tag>
  {subtitle && (
    <p class:list={[
      'text-base leading-relaxed max-w-2xl',
      center && 'mx-auto',
      light ? 'text-white/70' : 'text-muted',
    ]}>
      {subtitle}
    </p>
  )}
</div>
